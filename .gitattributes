# Normalize line endings in the repository, and force LF on everything that is
# executed on the Linux target. A CRLF `install.sh` fails on the server with an
# unhelpful "bad interpreter" error, which is easy to produce by cloning on
# Windows with core.autocrlf=true.
* text=auto

*.sh        text eol=lf
*.py        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.example   text eol=lf
*.service   text eol=lf
